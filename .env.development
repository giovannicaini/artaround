# Development Environment Variables

# Server
NODE_ENV=development
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/artaround_dev

# JWT
JWT_SECRET=dev_secret_key_change_in_production_12345678
JWT_EXPIRES_IN=7d

# OpenAI/Claude (for translations and AI features)
OPENAI_API_KEY=your_openai_api_key_here
# or
ANTHROPIC_API_KEY=your_claude_api_key_here

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8000

# File Upload
MAX_FILE_SIZE=10485760

# Wikidata API
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
