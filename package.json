{
  "name": "artaround",
  "version": "1.0.0",
  "private": true,
  "description": "ArtAround - l'unica audioguida pensata per te",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "seed": "npm run seed --workspace=apps/server"
  },
  "devDependencies": {
    "turbo": "^2.8.10",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
