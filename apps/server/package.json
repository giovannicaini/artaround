{
  "name": "@artaround/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ArtAround backend server with Express and MongoDB",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:new": "tsx src/scripts/seed-new.ts",
    "seed:images:retry": "tsx src/scripts/retry-missing-artwork-images.ts",
    "seed:borghese": "tsx src/scripts/seed-borghese.ts",
    "seed:uffizi": "tsx src/scripts/seed-borghese.ts --seed-file seed-uffizi.json --cache-file seed-uffizi.items-cache.v2.json",
    "generate:borghese": "tsx src/scripts/generate-borghese-top50.ts",
    "generate:visits": "tsx src/scripts/generate-visits.ts",
    "migrate:legacy-museum-ids": "tsx src/scripts/migrate-legacy-museum-ids.ts",
    "migrate:legacy-museum-ids:dry": "tsx src/scripts/migrate-legacy-museum-ids.ts --dry-run",
    "migrate:museum-location-nation": "tsx src/scripts/migrate-museum-location-nation.ts",
    "migrate:museum-location-nation:dry": "tsx src/scripts/migrate-museum-location-nation.ts --dry-run",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@artaround/shared": "*",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.5",
    "@types/sharp": "^0.31.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
