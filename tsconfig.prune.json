{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@artaround/shared": ["packages/shared/src/index.ts"],
      "@artaround/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": ["apps/**/src/**/*.ts", "packages/**/src/**/*.ts"],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/build/**"]
}
